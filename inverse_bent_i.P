#strain = 0.2
% ----------------------------------------------------------------------------------------
% message
% ----------------------------------------------------------------------------------------
% ----  New Output Path  -----------------------------------------------------------------
!SetOutputPath={results_inverse_i}
% ----  Define Time Scheme  --------------------------------------------------------------
!DefTimeStepScheme={time}
  1  200  0.01
% ----  Solver Groups  -------------------------------------------------------------------
!DefSolverGroup={Main|time}
  !SetSolverGroup={Main|AddVariables|C|R|Z}
  !SetSolverGroup={Main|export_initial_condition}
  !SetSolverGroup={Main|L2TOL|1e-09}
  !SetSolverGroup={Main|LINESEARCHITER|8}
  !SetSolverGroup={Main|SUBITERATION|5}
!DefSolverSubGroup={Main|seq_fp_linesearch|SolidMatrix|ScaleFirstResidual[100000.0]}
!DefSolverSubGroup={Main|solver_sequential|FMatrix}
% ----  Solver Matrices  -----------------------------------------------------------------
!DefSolverMatrix={SolidMatrix|SOLVER_MUMPS}
    SolidU0
    PRRotPU0Inlet
  !SetSolverMatrix={SolidMatrix|SuppressOutput}
  !SetSolverMatrix={SolidMatrix|ordering|parallel}
  !SetSolverMatrix={SolidMatrix|SolverMatrixCalculation|evaluate_every_build}
!DefSolverMatrix={FMatrix|SOLVER_MUMPS|FCalcSolid}
  !SetSolverMatrix={FMatrix|SuppressOutput}
  !SetSolverMatrix={FMatrix|ordering|parallel}
  !SetSolverMatrix={FMatrix|SolverMatrixCalculation|evaluate_every_build}
% ----  Basis Functions  -----------------------------------------------------------------
!UseBasis={QHex|HEXAHEDRAL_ELEMENT|NL2|GAUSS_LEGENDRE9}
!UseBasis={QQuad|QUADRILATERAL_ELEMENT|NL2|GAUSS_LEGENDRE9}
!UseBasis={LHex|HEXAHEDRAL_ELEMENT|NL1|GAUSS_LEGENDRE9}
!UseBasis={ZQuad|QUADRILATERAL_ELEMENT|NL0|GAUSS_LEGENDRE9}
% ----  Topologies  ----------------------------------------------------------------------
!DefTopology={TPQuad|mesh_bent_cylinder/cyl_quad|QHex}
!DefTopology={TPLin|mesh_bent_cylinder/cyl_lin|LHex}
!DefTopology={TPSurfinner|mesh_bent_cylinder/cyl_quad_inner|QQuad}
  !SetTopology={TPSurfinner|CreateInBoundary|[TPQuad;3]}
!DefTopology={TPSurfouter|mesh_bent_cylinder/cyl_quad_outer|QQuad}
  !SetTopology={TPSurfouter|CreateInBoundary|[TPQuad;4]}
!DefTopology={TPSurfinlet|mesh_bent_cylinder/cyl_quad_inlet|QQuad}
  !SetTopology={TPSurfinlet|CreateInBoundary|[TPQuad;1]}
!DefTopology={TPSurfoutlet|mesh_bent_cylinder/cyl_quad_outlet|QQuad}
  !SetTopology={TPSurfoutlet|CreateInBoundary|[TPQuad;2]}
!DefInterface={OneToOne|TPLin|TPQuad}
!DefInterface={ManyToOne|TPSurfinlet|TPQuad|mesh_bent_cylinder/interface-inlet.IN|NestedInBndry[1]}
!DefInterface={ManyToOne|TPSurfoutlet|TPQuad|mesh_bent_cylinder/interface-outlet.IN|NestedInBndry[2]}
% ----  Variables  -----------------------------------------------------------------------
!DefVariablePointer={template|TPLin|mesh_bent_cylinder/cyl_lin|3}
!DefVariablePointer={XInitial|TPQuad|mesh_bent_cylinder/cyl_quad|3}
!DefVariablePointer={UDef|TPQuad|results_forward_old/U-200.D|3}

!DefVariablePointer={Xi|TPQuad|3}
  !SetVariablePointer={Xi|INIT_EXPR|load_xdef}
!DefVariablePointer={X0|TPQuad|3}
  !SetVariablePointer={X0|INIT_EXPR|load_xdef}
!DefVariablePointer={U|TPQuad|3}
!DefVariablePointer={R|TPQuad|mesh_bent_cylinder/R-0.D|3}
!DefVariablePointer={Z|TPQuad|mesh_bent_cylinder/Z-0.D|3}
!DefVariablePointer={C|TPQuad|mesh_bent_cylinder/C-0.D|3}
!DefVariablePointer={F|TPQuad|9}
!DefVariablePointer={P|TPLin|1}
!DefVariablePointer={ResF|TPQuad|9}
  !SetVariablePointer={ResF|TEMPORAL_UPDATE_EXPR|residual_stretch}
!DefVariablePointer={RLMPU0Inlet|null_topology|1}
!DefVariablePointer={RLMPU0Outlet|null_topology|3}
% ----  Export Frequency  ----------------------------------------------------------------
!SetExportFrequency={X0|Xi|P|U|R|Z|C|F|1}
!SetExportFrequency={RLMPU0Inlet|RLMPU0Outlet|-1}
% ----  Problem Definitions  -------------------------------------------------------------
!DefProblem={SolidU0|quasi_static_elasticity}
  !UseVariablePointer={Space|X0}
  !UseVariablePointer={Displacement|U}
  !UseVariablePointer={Pressure|P}
  !UseVariablePointer={ResidualF|ResF}
  !Inverse-mechanics
  !Density={1e-06}
  !ConstitutiveLaw={neohookean}
    10.0
  !Boundary-patch-definitions
    3  U  scaled_normal  P0_expr
    1  U.1  dirichlet  0
    2  U  dirichlet  0 0 0

!DefProblem={PRRotPU0Inlet|fscoupling_problem}
  !UseVariablePointer={Space|Xi}
  !Addterms={TestVariable[U]|RLMPU0Inlet[PBRotPU0Inlet_Mexpr]}
  !Addterms={TestVariable[RLMPU0Inlet*]|U[PBRotPU0Inlet_Mexpr]}
  !SetPerturbationBuild
  !SetRootTopology={TPSurfinlet}
  !Boundary-conditions-not-required

!DefProblem={PRRotPU0Outlet|fscoupling_problem}
  !UseVariablePointer={Space|X0}
  !Addterms={TestVariable[U]|RLMPU0Outlet[PBRotPU0Outlet_Mexpr_T]}
  !Addterms={TestVariable[RLMPU0Outlet*]|U[PBRotPU0Outlet_Mexpr]}
  !SetPerturbationBuild
  !SetRootTopology={TPSurfoutlet}
  !Boundary-conditions-not-required

!DefProblem={FCalcSolid|l2solidprojection_problem}
  !UseVariablePointer={Space|X0}
  !UseVariablePointer={Variable|F}
  !Mechanical-Problem={SolidU0}
  !Projected-Variable={deformation_gradient}
  !Boundary-conditions-not-required

!DefExpression={load_xdef}
  XInitial.1 + UDef.1
  XInitial.2 + UDef.2
  XInitial.3 + UDef.3

!DefExpression={stretch_expr}
  1.0 + #strain * min(t, 1.0)

!DefExpression={offaxial_compress}
  1.0 / sqrt(stretch_expr)

!DefExpression={residual_z}
  stretch_expr * Z.1 * Z.1
  stretch_expr * Z.1 * Z.2
  stretch_expr * Z.1 * Z.3
  stretch_expr * Z.2 * Z.1
  stretch_expr * Z.2 * Z.2
  stretch_expr * Z.2 * Z.3
  stretch_expr * Z.3 * Z.1
  stretch_expr * Z.3 * Z.2
  stretch_expr * Z.3 * Z.3

!DefExpression={residual_c}
  offaxial_compress * C.1 * C.1
  offaxial_compress * C.1 * C.2
  offaxial_compress * C.1 * C.3
  offaxial_compress * C.2 * C.1
  offaxial_compress * C.2 * C.2
  offaxial_compress * C.2 * C.3
  offaxial_compress * C.3 * C.1
  offaxial_compress * C.3 * C.2
  offaxial_compress * C.3 * C.3

!DefExpression={residual_q}
  offaxial_compress * R.1 * R.1
  offaxial_compress * R.1 * R.2
  offaxial_compress * R.1 * R.3
  offaxial_compress * R.2 * R.1
  offaxial_compress * R.2 * R.2
  offaxial_compress * R.2 * R.3
  offaxial_compress * R.3 * R.1
  offaxial_compress * R.3 * R.2
  offaxial_compress * R.3 * R.3

!DefExpression={residual_stretch}
  residual_z.1 + residual_c.1 + residual_q.1
  residual_z.2 + residual_c.2 + residual_q.2
  residual_z.3 + residual_c.3 + residual_q.3
  residual_z.4 + residual_c.4 + residual_q.4
  residual_z.5 + residual_c.5 + residual_q.5
  residual_z.6 + residual_c.6 + residual_q.6
  residual_z.7 + residual_c.7 + residual_q.7
  residual_z.8 + residual_c.8 + residual_q.8
  residual_z.9 + residual_c.9 + residual_q.9


!DefExpression={P0_expr}
  -2.1*min(1.0*(t - 1.0), 1) * (t > 1.0)

!DefExpression={PBRotPU0Inlet_Mexpr}
  0
  X0.3
  -X0.2

!DefExpression={PBRotPU0Outlet_Mexpr}
  1
  0
  0
  0
  1
  0
  X0.2
  -X0.1
  0

!DefExpression={PBRotPU0Outlet_Mexpr_T}
  1
  0
  X0.2
  0
  1
  -X0.1
  0
  0
  0