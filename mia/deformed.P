#strain = 0.2
% ----------------------------------------------------------------------------------------
% message
% ----------------------------------------------------------------------------------------
% ----  New Output Path  -----------------------------------------------------------------
!SetOutputPath={results_mia_deformed}
% ----  Define Time Scheme  --------------------------------------------------------------
!DefTimeStepScheme={time}
  1  200  0.01
% ----  Solver Groups  -------------------------------------------------------------------
!DefSolverGroup={Main|time}
  !SetSolverGroup={Main|AddVariables|ResidualWeights|ResidualVectors}
  !SetSolverGroup={Main|export_initial_condition}
  !SetSolverGroup={Main|L2TOL|1e-09}
!DefSolverSubGroup={Main|seq_fp_linesearch|SolidMatrix|ScaleFirstResidual[100000.0]}
% ----  Solver Matrices  -----------------------------------------------------------------
!DefSolverMatrix={SolidMatrix|SOLVER_MUMPS|SolidU0}
  !SetSolverMatrix={SolidMatrix|SuppressOutput}
  !SetSolverMatrix={SolidMatrix|ordering|parallel}
  !SetSolverMatrix={SolidMatrix|SolverMatrixCalculation|evaluate_every_build}

% ----  Basis Functions  -----------------------------------------------------------------
!UseBasis={QTet|TETRAHEDRAL_ELEMENT|NL2|KEAST_LYNESS4}
!UseBasis={QTri|TRIANGLE_ELEMENT|NL2|KEAST_LYNESS4}
!UseBasis={LTet|TETRAHEDRAL_ELEMENT|NL1|KEAST_LYNESS4}
!UseBasis={LTri|TRIANGLE_ELEMENT|NL1|KEAST_LYNESS4}
!UseBasis={ZQuad|TRIANGLE_ELEMENT|NL0|KEAST_LYNESS4}
% ----  Topologies  ----------------------------------------------------------------------
!DefTopology={TPQuad|mesh_mia/model_quad|QTet}
!DefTopology={TPLin|mesh_mia/model|LTet}
!DefTopology={TPInlet|mesh_mia/model_inlet|LTri}
  !SetTopology={TPInlet|CreateInBoundary|[TPQuad;1]}
!DefTopology={TPOutlet|mesh_mia/model_outlet|LTri}
  !SetTopology={TPOutlet|CreateInBoundary|[TPQuad;2]}
!DefInterface={OneToOne|TPLin|TPQuad}
!DefInterface={ManyToOne|TPInlet|TPLin|mesh_mia/interface-inlet.IN|NestedInBndry[1]}
!DefInterface={ManyToOne|TPOutlet|TPLin|mesh_mia/interface-outlet.IN|NestedInBndry[2]}
% ----  Variables  -----------------------------------------------------------------------
!DefVariablePointer={Xi|TPLin|mesh_mia/model|3}
!DefVariablePointer={X0|TPLin|mesh_mia/model|3}
!DefVariablePointer={U|TPLin|3}
!DefVariablePointer={P|TPLin|1}
!DefVariablePointer={R|TPLin|mesh_mia/R-0.D|3}
!DefVariablePointer={Z|TPLin|mesh_mia/Z-0.D|3}
!DefVariablePointer={C|TPLin|mesh_mia/C-0.D|3}
!DefVariablePointer={ResidualWeights|TPLin|3}
  !SetVariablePointer={ResidualWeights|TEMPORAL_UPDATE_EXPR|residual_weights}
!DefVariablePointer={ResidualVectors|TPLin|9}
  !SetVariablePointer={ResidualVectors|INIT_EXPR|residual_vectors}
!DefVariablePointer={ResidualDeformation|TPLin|9}
  !SetVariablePointer={ResidualDeformation|TEMPORAL_UPDATE_EXPR|residual_deformation}

% ----  Export Frequency  ----------------------------------------------------------------
!SetExportFrequency={X0|Xi|P|U|ResidualWeights|1}
!SetExportFrequency={ResidualVectors|-1}
% ----  Problem Definitions  -------------------------------------------------------------
!DefProblem={SolidU0|quasi_static_elasticity}
  !UseVariablePointer={Space|X0}
  !UseVariablePointer={Displacement|U}
  !UseVariablePointer={Pressure|P}
  !UseVariablePointer={ResidualF-weights|ResidualWeights}
  !UseVariablePointer={ResidualF-deformedvectors|ResidualVectors}  
  !Density={1e-06}
  !ConstitutiveLaw={neohookean}
    150.0
  !Nearly-incompressible
    1500.0  1500.0
  !Boundary-patch-definitions
    3  U  scaled_normal  pressure_curve
    2  U  dirichlet  0 0 0
    4  U  dirichlet  0 0 0
    5  U  dirichlet  0 0 0
    6  U  dirichlet  0 0 0
    7  U  dirichlet  0 0 0



!DefExpression={pressure_curve}
  -16.0 * min(1.0*(t - 1.0), 1) * (t > 1.0)

!DefExpression={axial_stretch}
  1.0 + #strain * min(t, 1.0)

!DefExpression={offaxis_compression}
  1.0 / sqrt(axial_stretch)

!DefExpression={residual_weights}
  axial_stretch
  offaxis_compression
  offaxis_compression

!DefExpression={residual_vectors}
  Z.1
  Z.2
  Z.3
  C.1
  C.2
  C.3
  R.1
  R.2
  R.3


!DefExpression={residual_z}
  axial_stretch * Z.1 * Z.1
  axial_stretch * Z.1 * Z.2
  axial_stretch * Z.1 * Z.3
  axial_stretch * Z.2 * Z.1
  axial_stretch * Z.2 * Z.2
  axial_stretch * Z.2 * Z.3
  axial_stretch * Z.3 * Z.1
  axial_stretch * Z.3 * Z.2
  axial_stretch * Z.3 * Z.3

!DefExpression={residual_c}
  offaxis_compression * C.1 * C.1
  offaxis_compression * C.1 * C.2
  offaxis_compression * C.1 * C.3
  offaxis_compression * C.2 * C.1
  offaxis_compression * C.2 * C.2
  offaxis_compression * C.2 * C.3
  offaxis_compression * C.3 * C.1
  offaxis_compression * C.3 * C.2
  offaxis_compression * C.3 * C.3

!DefExpression={residual_r}
  offaxis_compression * R.1 * R.1
  offaxis_compression * R.1 * R.2
  offaxis_compression * R.1 * R.3
  offaxis_compression * R.2 * R.1
  offaxis_compression * R.2 * R.2
  offaxis_compression * R.2 * R.3
  offaxis_compression * R.3 * R.1
  offaxis_compression * R.3 * R.2
  offaxis_compression * R.3 * R.3


!DefExpression={residual_deformation}
  residual_z.1 + residual_c.1 + residual_r.1
  residual_z.2 + residual_c.2 + residual_r.2
  residual_z.3 + residual_c.3 + residual_r.3
  residual_z.4 + residual_c.4 + residual_r.4
  residual_z.5 + residual_c.5 + residual_r.5
  residual_z.6 + residual_c.6 + residual_r.6
  residual_z.7 + residual_c.7 + residual_r.7
  residual_z.8 + residual_c.8 + residual_r.8
  residual_z.9 + residual_c.9 + residual_r.9
