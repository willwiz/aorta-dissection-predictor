{
  "include": [
    "data",
    "make_*.py",
    "compute_*.py",
    "construct_*.py",
    "main.py",
    "code-pkg",
    ".deps",
  ],
  "exclude": [
    ".git",
    ".venv",
    ".mypy_cache",
    "**/build",
    "**/node_modules",
    "**/__pycache__",
    "**/*.D",
    "**/*.inp",
    "**/.*",
    "**/*.vtu",
    "**/*.log",
    "prestretch_*",
  ],
  "ignore": [".deps"],
  "typeCheckingMode": "strict",
  "deprecateTypingAliases": true,
  "strictDictionaryInference": true,
  "strictListInference": true,
  "strictSetInference": true,
  "disableBytesTypePromotions": true,
  "reportMissingTypeStubs": "none",
}
