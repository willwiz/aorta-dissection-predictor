#strain = 0.2
#traction_release_factor=0.95
% ----------------------------------------------------------------------------------------
% message
% ----------------------------------------------------------------------------------------
% ----  New Output Path  -----------------------------------------------------------------
!SetOutputPath={results_release_straight_inverse}
% ----  Define Time Scheme  --------------------------------------------------------------
!DefTimeStepScheme={time}
  1  100  0.01
% ----  Solver Groups  -------------------------------------------------------------------
!DefSolverGroup={Main|time}
  !SetSolverGroup={Main|AddVariables|C|R|Z|ResidualWeights|ResidualVectors}
  !SetSolverGroup={Main|export_initial_condition}
  !SetSolverGroup={Main|L2TOL|1e-09}
!DefSolverSubGroup={Main|seq_fp_linesearch|SolidMatrix|ScaleFirstResidual[100000.0]}
!DefSolverSubGroup={Main|SOLVER_SEQUENTIAL|PBoundaryTractionCalc}
% ----  Solver Matrices  -----------------------------------------------------------------
!DefSolverMatrix={SolidMatrix|SOLVER_MUMPS}
    PSolid
    PRotationInlet
    PTranslationOutlet
  !SetSolverMatrix={SolidMatrix|SuppressOutput}
  !SetSolverMatrix={SolidMatrix|ordering|parallel}
  !SetSolverMatrix={SolidMatrix|SolverMatrixCalculation|evaluate_every_build}
% ----  Basis Functions  -----------------------------------------------------------------
!UseBasis={QHex|HEXAHEDRAL_ELEMENT|NL2|GAUSS_LEGENDRE9}
!UseBasis={QQuad|QUADRILATERAL_ELEMENT|NL2|GAUSS_LEGENDRE9}
!UseBasis={LHex|HEXAHEDRAL_ELEMENT|NL1|GAUSS_LEGENDRE9}
!UseBasis={ZQuad|QUADRILATERAL_ELEMENT|NL0|GAUSS_LEGENDRE9}
% ----  Topologies  ----------------------------------------------------------------------
!DefTopology={TPQuad|mesh_straight/quad|QHex}
!DefTopology={TPLin|mesh_straight/lin|LHex}
!DefTopology={TPInner|mesh_straight/inner|QQuad}
  !SetTopology={TPInner|CreateInBoundary|[TPQuad;3]}
!DefTopology={TPOuter|mesh_straight/outer|QQuad}
  !SetTopology={TPOuter|CreateInBoundary|[TPQuad;4]}
!DefTopology={TPInlet|mesh_straight/inlet|QQuad}
  !SetTopology={TPInlet|CreateInBoundary|[TPQuad;1]}
!DefTopology={TPOutlet|mesh_straight/outlet|QQuad}
  !SetTopology={TPOutlet|CreateInBoundary|[TPQuad;2]}
!DefInterface={OneToOne|TPLin|TPQuad}
!DefInterface={ManyToOne|TPInlet|TPQuad|mesh_straight/interface-inlet.IN|NestedInBndry[1]}
!DefInterface={ManyToOne|TPOutlet|TPQuad|mesh_straight/interface-outlet.IN|NestedInBndry[2]}
% ----  Variables  -----------------------------------------------------------------------
!DefVariablePointer={template|TPLin|mesh_straight/lin|3}
!DefVariablePointer={Xi|TPQuad|mesh_straight/quad|3}
!DefVariablePointer={X0|TPQuad|mesh_straight/quad|3}
!DefVariablePointer={U|TPQuad|3}
!DefVariablePointer={R|TPQuad|mesh_straight/R-0.D|3}
!DefVariablePointer={Z|TPQuad|mesh_straight/Z-0.D|3}
!DefVariablePointer={C|TPQuad|mesh_straight/C-0.D|3}
!DefVariablePointer={P|TPLin|1}
!DefVariablePointer={ResidualWeights|TPQuad|3}
  !SetVariablePointer={ResidualWeights|TEMPORAL_UPDATE_EXPR|residual_weights}
!DefVariablePointer={ResidualVectors|TPQuad|9}
  !SetVariablePointer={ResidualVectors|INIT_EXPR|residual_vectors}
!DefVariablePointer={RLMInlet|null_topology|3}
!DefVariablePointer={TLMOutlet|TPOutlet|3}
% ----  Export Frequency  ----------------------------------------------------------------
!SetExportFrequency={X0|Xi|P|U|R|Z|C|ResidualWeights|ResidualVectors|RLMInlet|TLMOutlet|1}
% ----  Problem Definitions  -------------------------------------------------------------
!DefProblem={PSolid|quasi_static_elasticity}
  !UseVariablePointer={Space|X0}
  !UseVariablePointer={Displacement|U}
  !UseVariablePointer={Pressure|P}
  !UseVariablePointer={ResidualF-weights|ResidualWeights}
  !UseVariablePointer={ResidualF-deformedvectors|ResidualVectors}
  !Inverse-mechanics
  !Density={1e-06}
  !ConstitutiveLaw={neohookean}
    10.0
  !Boundary-patch-definitions
    1  U.1  dirichlet  0

!DefProblem={PRotationInlet|fscoupling_problem}
  !UseVariablePointer={Space|Xi}
  !Addterms={TestVariable[U]|RLMInlet[rot_cons_inlet_T]}
  !Addterms={TestVariable[RLMInlet*]|U[rot_cons_inlet]}
  !SetPerturbationBuild
  !SetRootTopology={TPInlet}
  !Boundary-conditions-not-required

!DefProblem={PTranslationOutlet|fscoupling_problem}
  !UseVariablePointer={Space|Xi}
  !Addterms={TestVariable[U]|TLMOutlet}
  !Addterms={TestVariable[TLMOutlet*]|U}
  !SetPerturbationBuild
  !SetRootTopology={TPOutlet}
  !Boundary-conditions-not-required

!DefProblem={PBoundaryTractionCalc|norm_calculation}
  !UseVariablePointer={Space|X0}
  !UseVariablePointer={Term1|TLMOutlet}
  !UseVariablePointer={Term2|1}
  !SetRootTopology={TPOutlet}
  !SetPerturbationBuild
  !Output-filename={outlet_traction-0.D}
  !Boundary-conditions-not-required


!DefExpression={axial_stretch}
  1.0 + #strain * min(t, 1.0)

!DefExpression={offaxial_compression}
  1.0 / sqrt(axial_stretch)

!DefExpression={residual_weights}
  axial_stretch
  offaxial_compression
  offaxial_compression

!DefExpression={residual_vectors}
  Z.1
  Z.2
  Z.3
  C.1
  C.2
  C.3
  R.1
  R.2
  R.3

!DefExpression={pressure_curve}
  -2.1*min(1.0*(t - 1.0), 1) * (t > 1.0)

!DefExpression={rot_cons_inlet}
  0
  1
  0
  0
  0
  1
  0
  X0.3
  -X0.2

!DefExpression={rot_cons_inlet_T}
  0
  0
  0
  1
  0
  X0.3
  0
  1
  -X0.2
